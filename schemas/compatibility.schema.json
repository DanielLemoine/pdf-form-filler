{
  "type": "object",
  "properties": {
    "schema": {
      "const": "pdfform.compatibility/1"
    },
    "status": {
      "enum": [
        "supported",
        "configuration_needed",
        "invalid",
        "unsupported",
        "internal_error"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "templateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "templateBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800
    },
    "counts": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    },
    "configurationState": {
      "enum": [
        "absent",
        "draft",
        "reviewed",
        "invalid"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "capability": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "fieldId": {
            "type": "string",
            "pattern": "^field_[0-9a-f]{64}$"
          }
        },
        "required": [
          "code",
          "capability"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "missingEngineFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "requiredConfiguration": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "notAssessed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "status",
    "exitCode",
    "counts",
    "configurationState",
    "issues",
    "missingEngineFeatures",
    "requiredConfiguration",
    "notAssessed"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "configuration_needed"
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "internal_error"
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "supported",
              "configuration_needed",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "required": [
          "templateSha256",
          "templateBytes"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdfform:compatibility:1"
}
