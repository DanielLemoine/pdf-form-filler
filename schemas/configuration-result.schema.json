    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "artifactState": {
      "enum": [
        "none",
        "staged",
        "published",
        "unknown"
      ]
    },
    "validationLevels": {
      "type": "object",
      "properties": {
        "syntax": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
