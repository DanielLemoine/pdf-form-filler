          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "binding": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "bindingStructure": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "data": {
          "const": "not_run"
        },
        "packet": {
          "const": "not_run"
        },
        "render": {
          "const": "not_run"
        }
      },
      "required": [
        "syntax",
        "profile",
        "binding",
        "bindingStructure",
        "data",
        "packet",
        "render"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "properties": {
        "path": {
          "const": "template.pdf"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "path": {
          "const": "profile.json"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "profileVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "id",
        "revision",
        "profileVersion"
      ],
      "additionalProperties": false
