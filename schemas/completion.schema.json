{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdfform:completion:1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pdfform.completion/1"
    },
    "requestId": {
      "type": "string",
      "minLength": 0,
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "toolBuild": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 0,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 0,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "requestId",
    "toolBuild",
    "result",
    "artifacts"
  ],
  "additionalProperties": false
}
